# ============================================
# BACKEND CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/axsenwebsite

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Email Configuration (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key

# ============================================
# FRONTEND CONFIGURATION
# ============================================
REACT_APP_SITE_NAME=AxsenWebsite
REACT_APP_SITE_URL=https://axsenwebsite.com
REACT_APP_SITE_EMAIL=info@axsenwebsite.com
REACT_APP_GA_ID=G-1A2B3C4D5E

# ============================================
# CORS Configuration
# ============================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://axsenwebsite.com
